  },
  "peerDependencies": {
    "@tanstack/react-table": "^8.0.0",
    "@xeplr/ui-account": "^1.5.2",
    "@xeplr/ui-table": "^1.1.3",
    "@xeplr/ui-utils": "^1.1.8",
    "react": "^18.0.0 || ^19.0.0",
    "react-router-dom": "^6.0.0 || ^7.0.0"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "dev": "vite dev"
  },
  "devDependencies": {
    "@tanstack/react-table": "^8.21.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@xeplr/ui-account": "^1.5.2",
    "@xeplr/ui-table": "^1.1.3",
    "@xeplr/ui-utils": "^1.1.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
